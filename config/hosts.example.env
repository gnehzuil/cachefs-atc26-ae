# Copy to config/hosts.env and replace every placeholder. Do not commit hosts.env.
SSH_USER=root
# Shared default. Set NODE_A_SSH_PORT/NODE_B_SSH_PORT when nodes use different ports.
SSH_PORT=22
NODE_A_SSH_PORT=22
NODE_B_SSH_PORT=22

# SSH-reachable hostnames or addresses used by the coordinator.
NODE_A_HOST=host-a.example.net
NODE_B_HOST=host-b.example.net

# Routable IP addresses advertised to the CacheFS peers. Do not use loopback.
NODE_A_IP=192.0.2.10
NODE_B_IP=192.0.2.11

# Interfaces selected by `ip route get` toward the peer address.
CACHE_NIC_A=eth0
CACHE_NIC_B=eth0

# Temporary remote work root. The scripts create a unique subdirectory per run.
REMOTE_BASE_DIR=/tmp/cachefs-atc26-ae
